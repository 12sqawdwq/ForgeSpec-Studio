GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Provider order: zhipu,gemini means try Zhipu first, then Gemini, then fallback.
LLM_PROVIDER_ORDER=zhipu,gemini

# Zhipu / BigModel Open Platform
ZHIPU_API_KEY=PASTE_YOUR_ZHIPU_API_KEY_HERE
ZHIPU_MODEL=glm-4.5-flash
ZHIPU_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
